    "@supabase/ssr": "^0.12.0",
    "react-hook-form": "^7.51.0",
    "zod": "^3.22.0",
    "@hookform/resolvers": "^3.3.0",
    "lucide-react": "^0.358.0",
    "clsx": "^2.1.0",
